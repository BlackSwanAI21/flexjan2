# Auto detect text files and perform LF normalization
* text=auto

# JS/TS files
*.js text
*.ts text
*.jsx text
*.tsx text

# Config files
*.json text
*.yaml text
*.yml text
*.env.* text

# Documentation
*.md text
LICENSE text

# Ensure these files are treated as binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.zip binary 